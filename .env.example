# Optional PostgreSQL database connection string.
# If omitted, Pandey PG runs seamlessly in zero-config in-memory mode.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pandey_pg"

# Official Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized JavaScript origin: http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
